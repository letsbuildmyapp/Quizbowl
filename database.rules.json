{
  "rules": {
    "presence": {
      ".read": "auth != null && auth.token.role == 'teacher'",
      ".indexOn": ["classroomId"],
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['online'])"
      }
    }
  }
}
