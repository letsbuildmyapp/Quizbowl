# Copy this file to `.env.local` and fill in your Firebase project's web config.
# Get these from Firebase Console -> Project settings -> Your apps -> Web app SDK setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=

# Set to "1" to route SDK calls through the local Firebase emulators
VITE_USE_EMULATORS=0
